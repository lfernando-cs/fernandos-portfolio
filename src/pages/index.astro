---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Main from "../components/Main.astro";
import Startups from "../components/Startups.astro";
import { SITE_DESCRIPTION, PRINCIPAL_TITLE } from "../consts";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={PRINCIPAL_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="bg-black text-white">
    <Header />
    <Main />
    <Startups />
    <Footer />
  </body>
</html>
